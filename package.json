{
	"name": "@amxts/menu-core",
	"type": "module",
	"version": "1.6.2",
	"description": "Menus for amxts plugins, from ini files or code: conditions, placeholders, lists - and the mc_* natives for Pawn plugins.",
	"author": {
		"name": "kukson777",
		"url": "https://github.com/kukson777"
	},
	"license": "MIT",
	"homepage": "https://github.com/amxts/menu-core#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amxts/menu-core.git"
	},
	"keywords": [
		"amxts-module",
		"amxts-menus",
		"amxmodx",
		"counter-strike"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"types": "./src/index.ts",
	"files": [
		"README.md",
		"README.ru.md",
		"include",
		"src"
	],
	"amxts": {
		"module": "src/index.ts",
		"natives": "src/natives.ts",
		"include": "include/menu_core.inc"
	},
	"scripts": {
		"lint": "eslint",
		"lint:fix": "eslint --fix"
	},
	"peerDependencies": {
		"@amxts/core": "file:../../ts2pawn",
		"@amxts/universal-config": "file:../universal-config"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"eslint": "^10.11.0",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
